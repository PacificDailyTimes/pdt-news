# Maintainer: Pacific Daily Times
pkgname=pdt
pkgver=1.0.0
pkgrel=1
pkgdesc="pdt-news CMS (Go + PostgreSQL)"
arch=('x86_64')
url="https://github.com/PacificDailyTimes/pdt-news"
license=('GPL3')
depends=('postgresql')
makedepends=('go')
source=("https://github.com/PacificDailyTimes/pdt-news/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/pdt-news-$pkgver"
  GOPATH="$srcdir/go" go build -o pdt ./cmd/pdt
}

package() {
  cd "$srcdir/pdt-news-$pkgver"
  install -Dm755 pdt "$pkgdir/usr/bin/pdt"
  install -Dm644 contrib/pdt.service "$pkgdir/usr/lib/systemd/system/pdt.service"
  install -Dm644 contrib/nginx/pdt.conf "$pkgdir/usr/share/pdt/nginx/pdt.conf"
  install -Dm644 config.sample "$pkgdir/usr/share/pdt/config.sample"
  install -Dm755 contrib/pdt-install "$pkgdir/usr/share/pdt/pdt-install"
  mkdir -p "$pkgdir/usr/share/pdt" "$pkgdir/etc/pdt"
  cp -a web sql "$pkgdir/usr/share/pdt/"
}
